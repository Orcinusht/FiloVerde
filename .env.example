# Copia este archivo como .env.local y rellena los valores (en tu ordenador).
# En Vercel se ponen en: Project → Settings → Environment Variables.
# .env.local NUNCA se sube a GitHub (está en .gitignore).

# --- Públicas (pueden verse en el navegador; las protege RLS) ---
# Supabase → Project Settings → API (o "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...) o, en proyectos antiguos, la "anon public".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Secretas (solo servidor; NUNCA con prefijo NEXT_PUBLIC_) ---
# Clave de la API de Claude (console.anthropic.com → API Keys). Lee las capturas.
ANTHROPIC_API_KEY=
# Opcional: modelo que lee las capturas. Si no se pone, se usa claude-sonnet-5-5.
# Para más precisión (≈ el doble de caro): claude-opus-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5
# La service role / secret key de Supabase NO se usa en la app. No la pongas aquí.
